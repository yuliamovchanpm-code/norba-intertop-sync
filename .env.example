# --- KeyCRM ---
KEYCRM_API_KEY=
# ID джерела "Intertop", яке треба створити в KeyCRM (Налаштування -> Джерела)
KEYCRM_INTERTOP_SOURCE_ID=
# ID служби доставки "Нова Пошта" в KeyCRM (GET /order/delivery-service) -
# потрібен, щоб warehouse_ref (відділення НП) коректно підхопився в замовленні
KEYCRM_NP_DELIVERY_SERVICE_ID=4

# --- Intertop (кабінет продавця -> Розробникам/API) ---
INTERTOP_APP_KEY=
INTERTOP_APP_SECRET=
# https://api-partner.intertop.com/api/v2 (prod) або https://dev-api-partner.intertop.com/api/v2 (dev)
INTERTOP_API_BASE=https://api-partner.intertop.com/api/v2
# зовнішній код складу в кабінеті Intertop (за замовчуванням "default")
INTERTOP_WAREHOUSE_ID=default

# status_id пайплайну статусів KeyCRM (Налаштування -> Статуси замовлень).
# Дефолти нижче відповідають поточному пайплайну Юлії - міняти тільки якщо
# статуси в KeyCRM зміняться.
KEYCRM_STATUS_ID_SHIPPED=8          # передано у доставку -> Intertop "assembled" + waybill
KEYCRM_STATUS_ID_DELIVERED=27       # доставлено (на відділенні) -> без дії, Intertop сам стежить за ТТН
KEYCRM_STATUS_ID_DONE=26            # виконано, клієнт забрав -> Intertop "done"
KEYCRM_STATUS_ID_CANCELED=19        # скасовано -> Intertop "canceled" (потрібен INTERTOP_CANCEL_REASON_ID)
KEYCRM_STATUS_ID_RETURN=23          # повернення -> Intertop "revert" (потребує revert_waybill, поки НЕ автоматизовано)
KEYCRM_STATUS_ID_OUT_OF_STOCK=15    # немає в наявності -> Intertop "canceled" (потрібен INTERTOP_OUT_OF_STOCK_CANCEL_REASON_ID)

# ID причини скасування в Intertop (GET /order/status -> cancel_reasons для
# статусу "canceled"). Без цих ID автоскасування пропускається (лог: "blocked").
INTERTOP_CANCEL_REASON_ID=
INTERTOP_OUT_OF_STOCK_CANCEL_REASON_ID=

# --- Розклад (опційно, формат cron) ---
STOCK_SYNC_CRON=0 * * * *
ORDERS_SYNC_CRON=*/15 * * * *
STATUS_SYNC_CRON=5-59/15 * * * *

# --- Сховище ---
DB_PATH=/data/sync.db
